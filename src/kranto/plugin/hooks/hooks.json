{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Bash|Grep|Glob",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/secrets.py\"",
           "timeout": 10}
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write|Bash",
        "hooks": [
          {"type": "command",
           "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry.py\" claude",
           "timeout": 5}
        ]
      },
      {
        "matcher": "mcp__plugin_kranto_kranto__.*|mcp__kranto__.*",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/allow.py\"",
           "timeout": 10}
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {"type": "command",
           "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry.py\" claude",
           "timeout": 5}
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {"type": "command",
           "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry.py\" claude",
           "timeout": 3}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command",
           "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry.py\" claude",
           "timeout": 3}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_kranto_kranto__.*|mcp__kranto__.*",
        "hooks": [
          {"type": "command",
           "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry.py\" claude",
           "timeout": 3}
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__plugin_kranto_kranto__.*|mcp__kranto__.*",
        "hooks": [
          {"type": "command",
           "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry.py\" claude",
           "timeout": 3}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command",
           "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry.py\" claude",
           "timeout": 3}
        ]
      }
    ]
  }
}
