{
  "schema": 1,
  "about": "The allow-list of everything Kranto's usage reports may hold (section 1.4). A field not named here is dropped and counted, never redacted. Strings exist only as enums and patterns. the page adds its own enums and lines (the page's actions and views) from src/kranto/page/telemetry.json. Keys with {name} stand for one key per value of the enum or pattern of that name.",
  "patterns": {
    "version": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,4}(-rc\\d{1,3}|-dev\\d{1,4})?$",
    "day": "^\\d{4}-\\d{2}-\\d{2}$",
    "uuid4": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
    "country": "^[A-Z]{2}$",
    "signature": "^[0-9a-f]{16}$",
    "exc_type": "^[A-Za-z_][A-Za-z0-9_]{0,63}(\\.[A-Za-z_][A-Za-z0-9_]{0,63}){0,6}$",
    "stack": "^(((kranto|bears_cub)(\\.[a-z_][a-z0-9_]{0,40}){0,8}\\.[A-Za-z_<>][A-Za-z0-9_<>]{0,60}:\\d{1,6}|\\[[A-Za-z0-9_][A-Za-z0-9_.-]{0,59}\\])( > ((kranto|bears_cub)(\\.[a-z_][a-z0-9_]{0,40}){0,8}\\.[A-Za-z_<>][A-Za-z0-9_<>]{0,60}:\\d{1,6}|\\[[A-Za-z0-9_][A-Za-z0-9_.-]{0,59}\\])){0,39})?$",
    "fingerprint": "^[A-Z][A-Za-z0-9_]{0,63}(:kranto(\\.[a-z_][a-z0-9_]{0,40}){0,6}\\.[A-Za-z_<>][A-Za-z0-9_<>]{0,60}:\\d{1,6}){1,5}$"
  },
