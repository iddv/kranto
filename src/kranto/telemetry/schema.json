  "resource": {
    "schema": {"type": "int", "min": 1, "max": 1, "tier": "basic", "example": 1,
               "doc": "the version of this list"},
    "tier": {"type": "str", "enum": "tier", "tier": "basic", "example": "basic",
             "doc": "which fields may follow"},
    "version": {"type": "str", "pattern": "version", "tier": "basic", "example": "0.3.82",
                "doc": "errors and update health by version"},
    "channel": {"type": "str", "enum": "channel", "tier": "basic", "example": "stable",
                "doc": "the update channel"},
    "os": {"type": "str", "enum": "os", "tier": "basic", "example": "linux",
           "doc": "the operating system family"},
    "distro": {"type": "str", "enum": "distro", "tier": "basic", "example": "debian",
               "doc": "install bugs by family; never the version string"},
    "arch": {"type": "str", "enum": "arch", "tier": "basic", "example": "x86_64",
             "doc": "the processor family"},
    "python": {"type": "str", "enum": "python", "tier": "basic", "example": "3.12",
               "doc": "the Python minor version"},
    "run_mode": {"type": "str", "enum": "run_mode", "tier": "basic", "example": "systemd",
                 "doc": "how Kranto runs: the service, the foreground or a container"},
    "install_id": {"type": "str", "pattern": "uuid4", "tier": "detailed",
                   "example": "a random id",
                   "doc": "detailed only: a random id, replaced every 180 days or when you reset it"},
    "country": {"type": "str", "pattern": "country", "tier": "relay", "example": "DE",
                "doc": "set by the receiving server from the connection, never by Kranto; the address is discarded"},
    "relay_dropped": {"type": "int", "min": 0, "max": 100000, "tier": "relay", "example": 0,
                      "doc": "set by the receiving server: keys from a newer Kranto it did not know yet, dropped"},
    "relay_other": {"type": "int", "min": 0, "max": 100000, "tier": "relay", "example": 0,
                    "doc": "set by the receiving server: routes and actions from a newer Kranto it did not know yet, counted as other"}
  },
  "lines": {
    "view": {
      "node": {"type": "str", "enum": "node", "required": true},
      "ms": {"type": "int", "min": 0, "max": 600000}
    },
    "api": {
      "route": {"type": "str", "enum": "route", "required": true},
      "n2": {"type": "int", "min": 0, "max": 10000000},
      "n3": {"type": "int", "min": 0, "max": 10000000},
      "n4": {"type": "int", "min": 0, "max": 10000000},
      "n5": {"type": "int", "min": 0, "max": 10000000},
      "slow": {"type": "int", "min": 0, "max": 10000000},
      "h": {"type": "list", "items": {"type": "int", "min": 0, "max": 10000000},
            "max_items": 12}
    },
    "error": {
      "fingerprint": {"type": "str", "pattern": "fingerprint", "required": true},
      "where": {"type": "str", "enum": "where", "required": true}
    }
  },
  "daily": {
    "day": {"type": "str", "pattern": "day", "example": "2026-10-17",
            "doc": "the day the report covers (UTC): the only time in it"},
    "install_age_weeks": {"type": "int", "min": 0, "max": 52, "example": 3,
                          "doc": "weeks since the install began, capped at 52: retention by cohort"},
    "milestones.{milestone}": {"type": "bool", "example": true,
                               "doc": "set once and then true: the funnel, without an identifier"},
    "actions.{action}": {"type": "int", "min": 0, "max": 100000, "example": 4,
                         "doc": "how often each button or command was used; never what it was used on"},
    "actions_by_origin.{origin}": {"type": "int", "min": 0, "max": 100000, "example": 2,
                                   "doc": "which doors are used: the page, kranto mcp, the command line, the loop"},
    "actions_refused": {"type": "int", "min": 0, "max": 100000, "example": 0,
                        "doc": "actions refused or failed"},
    "pages.{node}": {"type": "int", "min": 0, "max": 100000, "example": 9,
                     "doc": "page views by page; never which object was open"},
    "pages.load_ms_p50": {"type": "int", "min": 0, "max": 600000, "example": 420,
                          "doc": "how long pages take to show"},
    "watch.items_judged": {"type": "int", "min": 0, "max": 1000000, "example": 453,
                           "doc": "the watcher's volume, not its content"},
    "watch.items_kept": {"type": "int", "min": 0, "max": 1000000, "example": 251,
                         "doc": "items kept as observations"},
    "watch.cards_written": {"type": "int", "min": 0, "max": 10000, "example": 3,
                            "doc": "idea cards written"},
    "watch.usd_cents": {"type": "int", "min": 0, "max": 10000000, "example": 55,
                        "doc": "what watching cost that day, in cents"},
    "watch.sources_by_kind.{source_kind}": {"type": "int", "min": 0, "max": 999, "example": 12,
                                            "doc": "which kinds of source are used; never a URL"},
    "topics_count": {"type": "int", "min": 0, "max": 999, "example": 3,
                     "doc": "how many topics (capped at 999)"},
    "sources_count": {"type": "int", "min": 0, "max": 999, "example": 33,
                      "doc": "how many sources (capped at 999)"},
    "api.requests": {"type": "int", "min": 0, "max": 100000000, "example": 4120,
                     "doc": "requests the server answered"},
    "api.latency_ms_p50": {"type": "int", "min": 0, "max": 600000, "example": 18,
                           "doc": "how fast the server answers (median)"},
    "api.latency_ms_p95": {"type": "int", "min": 0, "max": 600000, "example": 140,
                           "doc": "how fast the server answers (95th percentile)"},
    "api.latency_ms_p99": {"type": "int", "min": 0, "max": 600000, "example": 600,
                           "doc": "how fast the server answers (99th percentile)"},
    "api.errors_4xx": {"type": "int", "min": 0, "max": 100000000, "example": 12,
                       "doc": "requests refused"},
    "api.errors_5xx": {"type": "int", "min": 0, "max": 100000000, "example": 0,
                       "doc": "requests that failed"},
    "api.slow.{route}": {"type": "int", "min": 0, "max": 100000000, "example": 3,
                         "doc": "requests over a second, by route pattern; never the address's ids"},
    "update.checked": {"type": "int", "min": 0, "max": 1000, "example": 1,
                       "doc": "update checks that worked"},
    "update.check_failed": {"type": "int", "min": 0, "max": 1000, "example": 0,
                            "doc": "update checks that failed"},
    "update.applied": {"type": "int", "min": 0, "max": 1000, "example": 1,
                       "doc": "updates applied"},
    "update.rolled_back": {"type": "int", "min": 0, "max": 1000, "example": 0,
                           "doc": "updates rolled back"},
    "update.failed": {"type": "int", "min": 0, "max": 1000, "example": 0,
                      "doc": "updates that failed"},
    "update.stop_warning": {"type": "int", "min": 0, "max": 1000, "example": 0,
                            "doc": "updates where the old server did not stop cleanly"},
    "update.from_version": {"type": "str", "pattern": "version", "example": "0.3.81",
                            "doc": "the version the last update came from: upgrade paths"},
    "errors.{fingerprint}": {"type": "int", "min": 0, "max": 1000000,
                             "example": "errors.KeyError:kranto.page.loop.gate.hold:212: 2",
                             "doc": "errors by class and the lines of Kranto's own code they passed through; never the message"},
    "errors.other": {"type": "int", "min": 0, "max": 1000000, "example": 0,
                     "doc": "errors past the twentieth distinct one that day"},
    "settings.caps_set": {"type": "str", "enum": "caps_set", "example": "none",
                          "doc": "whether spend caps are used"},
    "settings.term_enabled": {"type": "bool", "example": false,
                              "doc": "whether Open in Claude Code is on"},
    "settings.auto_update_idle": {"type": "bool", "example": false,
                                  "doc": "whether updates apply by themselves when idle"},
    "models.judge": {"type": "str", "enum": "model", "example": "claude-haiku-5-5",
                     "doc": "the watcher's judge model"},
    "models.reason": {"type": "str", "enum": "model", "example": "claude-sonnet-5-5",
                      "doc": "the watcher's reasoning model"},
    "provider": {"type": "str", "enum": "provider", "example": "openrouter",
                 "doc": "which model provider the watcher uses"},
    "dropped_fields": {"type": "int", "min": 0, "max": 100000000, "example": 0,
                       "doc": "values the allow-list dropped that day: a check on Kranto itself"},
    "sample_rate": {"type": "int", "min": 1, "max": 100, "example": 100,
                    "doc": "reserved for sampling: 100 means everything"}
  },
  "error": {
    "signature": {"type": "str", "pattern": "signature", "required": true,
                  "example": "9c1e5a07d2f44b18",
                  "doc": "a hash of the type and Kranto functions it passed through: the same error has the same signature on every install and release"},
    "type": {"type": "str", "pattern": "exc_type", "required": true, "example": "TypeError",
             "doc": "the exception's class: a built-in, a library's (its package and the class) or Kranto's own"},
    "where": {"type": "str", "enum": "where", "required": true, "example": "api",
              "doc": "where it happened: a request (api), a scheduled job (scheduler, job), one row of a list (row), the build loop (loop), an update's self-check (update), a Kranto tool call in an assistant's session (console)"},
    "route": {"type": "str", "enum": "route", "example": "/api/topics/{topic_id:int}",
              "doc": "the route's pattern when it happened in a request; never the address or its ids"},
    "job": {"type": "str", "enum": "job", "example": "ingest",
            "doc": "the job's kind when it happened in one (a cub's job is other)"},
    "message": {"type": "template", "max_len": 200,
                "example": "unsupported format string passed to NoneType.__format__",
                "doc": "the message as a template: only the words listed below survive, a number is <n>, any other word, a path, an address or a quoted value is <x>"},
    "stack": {"type": "str", "pattern": "stack", "max_len": 4000,
              "example": "[starlette] > kranto.web.topics_api.one_topic:226 > kranto.source_health._status:209",
              "doc": "where in Kranto's code: each of Kranto's own functions as module.function:line, a library's frames as [its package]; never a file path, a value or a variable"},
    "verb": {"type": "str", "enum": "verb", "example": "topic.add",
             "doc": "the console's own errors (where console): the verb whose tool call failed or timed out; never its fields"},
    "count": {"type": "int", "min": 1, "max": 1000000, "required": true, "example": 3,
              "doc": "how often it happened since this signature was last reported"}
  },
  "assistant": {
    "verb": {
      "verb": {"type": "str", "enum": "verb", "required": true, "example": "topic.add",
               "doc": "the verb's name (what kind of change), never what it was used on"},
      "surface": {"type": "str", "enum": "surface", "required": true, "example": "console",
                  "doc": "the door it came through: the page (ui), the console, kranto mcp (mcp), the command line (cli), a named agent"},
      "client": {"type": "str", "enum": "client", "required": true, "example": "claude-code",
                 "doc": "which assistant asked (from its token or session), none for the page and the command line"},
      "outcome": {"type": "str", "enum": "verb_outcome", "required": true, "example": "ok",
                  "doc": "done, refused, failed, prepared for your approval, or that action later confirmed or dismissed"},
      "refusal": {"type": "str", "enum": "refusal", "example": "never",
                  "doc": "a refusal's kind (never its words): the wrong door, reads only, off by your ladder, a lock, bad fields, no subject, signed out, still starting"},
      "rung": {"type": "str", "enum": "rung", "required": true, "example": "do",
               "doc": "the ladder's rung in force: you yourself (owner), Do it, Ask me, Never, or a lock"},
      "count": {"type": "int", "min": 1, "max": 1000000, "required": true, "example": 4,
                "doc": "how many such calls in that hour"},
      "ms_p50": {"type": "int", "min": 0, "max": 600000, "example": 180,
                 "doc": "how long they took (median, milliseconds)"},
      "ms_max": {"type": "int", "min": 0, "max": 600000, "example": 950,
                 "doc": "how long the slowest took (milliseconds)"}
    },
    "session": {
      "assistant": {"type": "str", "enum": "assistant", "required": true,
                    "example": "claude-code", "doc": "which assistant the session was"},
      "model": {"type": "str", "enum": "model", "example": "claude-sonnet-5-5",
                "doc": "its model, when it is one of the listed (else other)"},
      "place": {"type": "str", "enum": "place", "required": true, "example": "console",
                "doc": "the console in Kranto's page, or your own assistant outside it"},
      "profile": {"type": "str", "enum": "profile", "example": "full",
                  "doc": "Kranto's tools as the full list or the compact profile"},
      "start": {"type": "str", "enum": "session_start", "example": "startup",
                "doc": "how it started: new, resumed, after /clear, after a compaction"},
      "end": {"type": "str", "enum": "session_end", "example": "prompt_input_exit",
              "doc": "how it ended, as the assistant says it"},
      "minutes": {"type": "int", "min": 0, "max": 100000, "required": true, "example": 42,
                  "doc": "how long the session lasted, in whole minutes"},
      "turns": {"type": "int", "min": 0, "max": 100000, "example": 9,
                "doc": "how many answers the assistant gave"},
      "tool_calls": {"type": "int", "min": 0, "max": 100000, "example": 14,
                     "doc": "how many of Kranto's tools it called"},
      "tool_failures": {"type": "int", "min": 0, "max": 100000, "example": 1,
                        "doc": "how many of those failed or timed out"},
      "commands": {"type": "int", "min": 0, "max": 100000, "example": 2,
                   "doc": "how many of Kranto's slash commands were used"}
    },
    "command": {
      "command": {"type": "str", "enum": "command", "required": true, "example": "status",
                  "doc": "one of Kranto's slash commands (/kranto:status), by name; never the rest of what you typed"},
      "assistant": {"type": "str", "enum": "assistant", "required": true,
                    "example": "claude-code", "doc": "in which assistant"},
      "count": {"type": "int", "min": 1, "max": 100000, "required": true, "example": 1,
                "doc": "how often in that hour"}
    }
  }
}
